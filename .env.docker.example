# ============================================================================
# Konfigurasi produksi Docker + Cloudflare Tunnel
# Salin file ini menjadi .env lalu sesuaikan nilainya:
#   cp .env.docker.example .env
# File .env TIDAK boleh di-commit.
# ============================================================================

# --- Identitas publik ------------------------------------------------------
# Hanya untuk dokumentasi/rujukan; Caddy melayani HTTP :80 di belakang tunnel.
PUBLIC_HOSTNAME=traffic.example.com
CORS_ORIGINS=https://traffic.example.com

# --- Port lokal ------------------------------------------------------------
# Caddy hanya listen di loopback karena cloudflared berjalan di host.
# Untuk uji LAN: ubah APP_BIND=0.0.0.0 (atau pakai docker-compose.direct.yml).
APP_BIND=127.0.0.1
APP_PORT=8011

# --- Penyimpanan -----------------------------------------------------------
# Di dalam container selalu /data (named volume traffic-alpr_app_data).
STORAGE_DIR=/data
DATABASE_URL=sqlite:////data/violations.db

# --- Model & inferensi -----------------------------------------------------
MODEL_WEIGHTS=yolo11n.pt
# Catatan: docker-compose.yml memaksa DEVICE=cpu untuk image CPU. Overlay GPU
# memakai nilai DEVICE/OCR_GPU di bawah, dengan default DEVICE=0 + OCR_GPU=true
# bila tidak diisi. Untuk GPU Pascal lama (mis. GTX 1050 Ti) gunakan hybrid:
# DEVICE=0 dan OCR_GPU=false.
DEVICE=0
# Kosong = adaptif: 4K -> 1280, >=1600px -> 960, lainnya 640.
# Untuk VRAM 4 GB, isi eksplisit 960 atau 640.
IMGSZ=
FRAME_STRIDE=1
CONF_THRESHOLD=0.35
IOU_THRESHOLD=0.5

# Cloudflare Free membatasi body request 100 MB (Caddy max_size 100MB).
# 95 MB menyisakan ruang untuk overhead multipart.
MAX_UPLOAD_MB=95
# Batas keras di Caddy. Turunkan (mis. 50MB) bila uplink server lambat dan
# upload besar sering berakhir 524. Harus >= MAX_UPLOAD_MB.
CADDY_MAX_BODY=100MB

# --- ALPR ------------------------------------------------------------------
OCR_ENGINE=fast-alpr
ALPR_DETECTOR_MODEL=yolo-v9-t-384-license-plate-end2end
ALPR_OCR_MODEL=cct-s-v2-global-model
ALPR_MAX_SAMPLES=6

# false = paksa ALPR/OCR ke CPU (wajib untuk GTX 1050 Ti/Pascal dengan
# onnxruntime-gpu 1.31). true = coba CUDA, fallback ke CPU bila tidak tersedia.
# Nilai ini juga dipakai overlay docker-compose.gpu.yml.
OCR_GPU=true
OCR_CONF_THRESHOLD=0.35

# --- Mode demo (jangan diaktifkan di produksi) -----------------------------
MOCK_PIPELINE=0
MOCK_OCR=0

# --- Basic auth Caddy ------------------------------------------------------
# Buat hash bcrypt (jalankan di server):
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'passwordAnda'
# Tempel hasilnya di bawah, dan WAJIB pakai tanda kutip tunggal agar karakter
# '$' tidak diinterpolasi oleh Docker Compose.
BASIC_AUTH_USER=operator
BASIC_AUTH_HASH='$2a$14$GANTI_DENGAN_HASH_BCRYPT_DARI_PERINTAH_DI_ATAS'

# --- Build GPU (opsional, dibaca docker-compose.gpu.yml) -------------------
# Sesuaikan dengan driver NVIDIA di server (lihat docs/deploy-docker.md).
CUDA_IMAGE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu126
