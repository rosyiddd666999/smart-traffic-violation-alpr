# Salin ke .env lalu sesuaikan.
MODEL_WEIGHTS=yolo11n.pt
DEVICE=cpu

CONF_THRESHOLD=0.35
IOU_THRESHOLD=0.5

# Ukuran inferensi YOLO. 640 = default (cepat). Naikkan ke 960/1280
# bila kendaraan kecil/jauh (misalnya video 4K) sering terlewat.
# Kosongkan untuk mode adaptif: 4K -> 1280, >=1600px -> 960, lainnya 640.
IMGSZ=

# Proses setiap frame ke-N. 1 = semua frame (paling akurat).
FRAME_STRIDE=1

MAX_UPLOAD_MB=500

# ALPR (pembacaan plat). Engine utama: fast-alpr (ONNX, lokal).
# Pilihan: fast-alpr (default) atau easyocr (fallback).
OCR_ENGINE=fast-alpr
ALPR_DETECTOR_MODEL=yolo-v9-t-384-license-plate-end2end
ALPR_OCR_MODEL=cct-s-v2-global-model
# Jumlah frame terbaik per kendaraan yang dibaca lalu divoting per karakter.
ALPR_MAX_SAMPLES=6

# EasyOCR (hanya bila OCR_ENGINE=easyocr)
OCR_GPU=false
OCR_CONF_THRESHOLD=0.35

# Mode demo / pengujian tanpa model AI.
MOCK_PIPELINE=0
MOCK_OCR=0

# Kosongkan untuk default storage/violations.db
DATABASE_URL=
STORAGE_DIR=storage

# Pisahkan dengan koma. * untuk semua origin.
CORS_ORIGINS=*
